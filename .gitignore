# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents the optional settings
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/tmp
app/success-stories
app/resources
app/instructors
app/professional-dev/[program]
app/cookie-policy
ex

# credentials and secrets - never commit
**/*.pem
**/*.key
**/service-account*.json
**/credentials*.json
**/*-service-account*.json
public/ababeel-*.json
public/safetech-*.json

# local file storage
/storage/
/public/uploads/
/uploads/

.claude
.swc

# `docs/` and `__tests__/` were previously ignored, so no tests or docs were
# tracked. jest.config.js already points at `__tests__`, and the dynamic-CMS
# work ships both a suite and an architecture note, so they are tracked now.
# Re-add the two lines above this comment if that was deliberate.

# CMS content backups written by the seed scripts
/backups/
