# ---------------------------------------------------------------------------
# Ababeel — environment
#
# Required for the app to boot:
#   - MONGO_URI
#   - JWT_SECRET
#
# The rest are used by features such as login, password reset, email sending,
# owner bootstrap, image upload, and sitemap/robots generation.
# ---------------------------------------------------------------------------

# Required
MONGO_URI=
JWT_SECRET=

# Public app URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=
NEXT_PUBLIC_MAX_FILE_SIZE_IN_MB=10

# Auth & password reset tokens
FP_SECRET=
RESET_SECRET=

# Email configuration (used for reset, verification, and admin emails)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Owner bootstrap configuration
OWNER_SETUP_SECRET=
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_PASSWORD=

# ---- Scroll-animation frame storage -----------------------------------------
# local (default) writes to public/uploads/scroll-frames/.
STORAGE_PROVIDER=local

# Optional S3-compatible storage. Unset = not offered.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional Cloudinary. NOT required — the CMS is fully functional without it.
CLOUDINARY_URL=

# ---- Media processing --------------------------------------------------------
# Path to ffmpeg/ffprobe if they are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Upload limits -----------------------------------------------------------
MAX_VIDEO_SIZE_MB=500
MAX_FRAME_SIZE_MB=20
MAX_FRAME_COUNT=5000

# ---- Stripe ----------------------------------------------------------
# Used for partner / ATC deposit flows; not needed for public course registration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
