# ---------------------------------------------------------------------------
# Ababeel — environment
#
# Only MONGO_URI and JWT_SECRET are required to boot. Everything below them is
# optional: with none of it set the application runs on local filesystem
# storage exactly as it does today.
# ---------------------------------------------------------------------------

# Required
MONGO_URI=
JWT_SECRET=

# ---- Scroll-animation frame storage -----------------------------------------
# local (default) writes to public/uploads/scroll-frames/.
# Any other value falls back to local with a warning if it is not fully
# configured — a missing optional credential never takes the app down.
STORAGE_PROVIDER=local

# Optional S3-compatible storage. Unset = not offered.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional Cloudinary. NOT required — the CMS is fully functional without it.
# Leaving this blank is a supported configuration, not an error.
CLOUDINARY_URL=

# ---- Media processing --------------------------------------------------------
# Path to ffmpeg/ffprobe if they are not on PATH. When ffmpeg is unavailable the
# admin UI says so and the ZIP / multiple-frame routes are used instead.
FFMPEG_PATH=
FFPROBE_PATH=

# ---- Upload limits -----------------------------------------------------------
MAX_VIDEO_SIZE_MB=500
MAX_FRAME_SIZE_MB=20
MAX_FRAME_COUNT=5000

# ---- Public site URL ---------------------------------------------------------
# Used ONLY to write absolute URLs into sitemap.xml and robots.txt. Everything
# else on the site uses relative paths, so leaving this unset does not break
# any page — the sitemap just advertises the fallback domain, which search
# engines will then ignore as off-origin.
#
# Set it to the live origin, with no trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://www.example.com
#
# On Vercel, VERCEL_URL is picked up automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# ---- Existing integrations (unchanged) --------------------------------------
# Stripe belongs to the partner/ATC deposit flow only. Public course
# registration takes no payment and never reaches these keys — see
# lib/payments/provider.js, where the payment layer is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_USER=
EMAIL_PASS=
